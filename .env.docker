# Environment Configuration for Docker

# Ollama LLM Provider
# The base URL for the Ollama service
# In Docker: use service name 'ollama' from docker-compose network
# Locally: use http://localhost:11434
OLLAMA_BASE_URL=http://ollama:11434

# Python Runtime
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Optional: Custom model configuration can be set via config/models.dev.yaml
# instead of environment variables for better version control
